{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rinconadastereo",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
